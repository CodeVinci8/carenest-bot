# Скопируйте этот файл в .env и замените значения.
TELEGRAM_TOKEN=<токен_от_BotFather>
ALLOWED_IDS=<telegram_id_разрешённого_пользователя>
RECIPIENT_ID=<telegram_id_получателя_утренних_сообщений>

# Необязательные пути считаются от корня проекта.
CARENEST_CONFIG=config/personalization.json
CARENEST_DATA_DIR=data

# Временная совместимость: HER_ID используется только при отсутствии RECIPIENT_ID.
# HER_ID=<старый_telegram_id>
